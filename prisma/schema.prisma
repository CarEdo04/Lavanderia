generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres: DATABASE_URL goes through the connection pooler,
// DIRECT_URL connects directly and is used for migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Login, password and email confirmation live in Supabase Auth; this is the
// resident profile linked to it by authId.
model User {
  id              Int       @id @default(autoincrement())
  authId          String    @unique // Supabase Auth user id
  firstName       String
  lastName        String
  email           String    @unique
  emailVerifiedAt DateTime? // copied from Supabase Auth when the email is confirmed
  username        String?   @unique // optional, lowercase, can be used to log in
  room            String?
  rulesAcceptedAt DateTime?
  role            String    @default("USER") // USER | ADMIN
  createdAt       DateTime  @default(now()) // registration date
  bookings        Booking[]
}

model Machine {
  id        Int       @id @default(autoincrement())
  name      String
  type      String // WASHER | DRYER
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  machineId Int
  userId    Int
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  // Restrict: bookings are the laundry's history, so a machine or user that
  // has any can't be deleted (disable the machine instead).
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([machineId, start])
  @@index([userId, end])
  @@index([start, end])
}

// Admin announcement shown on the booking page for the weeks it overlaps.
model Notice {
  id        Int      @id @default(autoincrement())
  message   String
  level     String   @default("INFO") // INFO | WARNING
  startDay  String // YYYY-MM-DD, Europe/Rome, inclusive
  endDay    String // YYYY-MM-DD, inclusive
  createdAt DateTime @default(now())

  @@index([endDay])
}

// A sign-up the app has validated, waiting for Supabase Auth to create the
// account. A trigger on auth.users turns it into the User row in the same
// transaction (see the create_profile_on_signup migration), so an account
// never exists without its profile.
model PendingSignup {
  token           String    @id // also sent in the Auth user's metadata
  email           String
  firstName       String
  lastName        String
  room            String?
  rulesAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
}

// Failed logins and wrong registration codes, for rate limiting (src/lib/throttle.ts).
model AuthFailure {
  id        Int      @id @default(autoincrement())
  kind      String // LOGIN | CODE
  key       String // "ip:<address>" or "account:<email or username>"
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

// Single row (id = 1) holding the booking rules.
model Settings {
  id                Int     @id @default(1)
  slotMinutes       Int     @default(240)
  openHour          Int     @default(8)
  closeHour         Int     @default(24)
  closedWeekdays    String  @default("0") // digits, 0 = Sunday … 6 = Saturday
  maxActiveBookings Int     @default(3)
  maxDaysAhead      Int     @default(21)
  minHoursBefore    Int     @default(72) // bookings close this many hours before a shift starts
  registrationCode  String?
  rulesText         String? // null = default rules in src/lib/rules.ts
}
