DATABASE_URL="file:./dev.db"
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
# First administrator account, created by `npm run setup`
ADMIN_EMAIL="admin@lavanderia.test"
ADMIN_PASSWORD="change-me"

# Public address of the app, used in links inside emails
APP_URL="http://localhost:3000"

# SMTP server for verification emails. Leave SMTP_HOST empty in development:
# emails are then printed in the dev server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Lavanderia <no-reply@example.com>"
