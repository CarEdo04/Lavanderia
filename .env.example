# Supabase project → Connect (top bar) → ORMs → Prisma.
# Pooled connection (port 6543), used by the app:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432), used by migrations:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase project → Project Settings → API Keys (or Data API for the URL).
# The NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY names
# from Supabase's Next.js snippet work too.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Publishable key (sb_publishable_…), or the legacy "anon" key
SUPABASE_PUBLISHABLE_KEY=""
# Secret key (sb_secret_…), or the legacy "service_role" key. Never share it.
SUPABASE_SECRET_KEY=""

# Public address of the app, used in the links inside Supabase's emails
APP_URL="http://localhost:3000"

# First administrator account, created by `npm run setup`
ADMIN_EMAIL="admin@lavanderia.test"
ADMIN_PASSWORD="change-me"
